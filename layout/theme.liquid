<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f7f3ec">
    <link rel="canonical" href="{{ canonical_url }}">
    <meta name="description" content="Minimalist Jewellery — everyday fine jewellery. Certified diamonds, responsibly sourced, crafted to be worn for life.">
    <title>{{ page_title | default: shop.name }}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect x='6' y='6' width='12' height='12' fill='none' stroke='%2316181B' stroke-width='1.5' transform='rotate(45 12 12)'/%3E%3C/svg%3E">

    {{ content_for_header }}

    {{ 'mj-app.css' | asset_url | stylesheet_tag }}

    <script>
      window.MJ_ASSETS = {
        "/img/hero.png": {{ 'mj-hero.png' | asset_url | json }}
      };
    </script>

    {%- render 'mj-catalog' -%}
  </head>
  <body>
    <div id="root"></div>
    {%- comment -%}
      The app renders every storefront view itself, so whatever a template would
      output on these page types is deliberately discarded. That keeps leftover
      sections (the theme still holds some from its first import) and anything
      added by accident in the theme editor from ever showing under the footer.
      Shopify's own pages (captcha, policies, gift cards, accounts) render as usual.
    {%- endcomment -%}
    {%- assign app_pages = 'index,product,collection,list-collections,cart,search,404,blog,article,page' | split: ',' -%}
    {%- if app_pages contains request.page_type -%}
      {%- capture discarded -%}{{ content_for_layout }}{%- endcapture -%}
    {%- else -%}
      {{ content_for_layout }}
    {%- endif %}
    <script type="module" src="{{ 'mj-app.js' | asset_url }}"></script>
  </body>
</html>
